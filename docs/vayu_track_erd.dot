
digraph G {
  graph [rankdir=TB, splines=spline, nodesep=1.0, ranksep=1.0, bgcolor="white", pad=0.4, fontname="Helvetica",
         label=<<FONT POINT-SIZE="24"><B>Vayu Track: Database Schema (PostgreSQL)</B></FONT><BR/><FONT POINT-SIZE="12" COLOR="#475569">Star-style design: 1 dimension + 2 daily fact tables, joined on (city, date), exposed through 2 analytical views</FONT>>,
         labelloc=t];
  node [shape=plaintext, fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11, color="#334155", penwidth=1.6];

  cities [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#0f766e"><FONT COLOR="white" POINT-SIZE="15"><B>cities</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#b45309" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(9,6)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(9,6)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">elevation_m</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(7,2)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f1f5f9"><FONT POINT-SIZE="10" COLOR="#475569">50 rows  |  Dimension  |  idx: region</FONT></TD></TR></TABLE>>];
  weather [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#2563eb"><FONT COLOR="white" POINT-SIZE="15"><B>weather_daily</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#7c3aed" POINT-SIZE="10"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#b45309" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10" COLOR="#475569"><I>temperature</I></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">temperature_2m_max / min / mean</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(6,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">apparent_temperature_max</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(6,2)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10" COLOR="#475569"><I>moisture &amp; wind</I></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">precipitation_sum / precipitation_hours</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">relative_humidity_2m_mean</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">wind_speed_10m_max</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(6,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">wind_direction_10m_dominant</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(6,2)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10" COLOR="#475569"><I>energy &amp; condition</I></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">shortwave_radiation_sum</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">et0_fao_evapotranspiration</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(6,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">weather_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">SMALLINT</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f1f5f9"><FONT POINT-SIZE="10" COLOR="#475569">124,750 rows  |  Fact  |  2020-01-01 to 2026-10-30  |  idx: date</FONT></TD></TR></TABLE>>];
  aq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#dc2626"><FONT COLOR="white" POINT-SIZE="15"><B>air_quality_daily</B></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#7c3aed" POINT-SIZE="10"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#b45309" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">DATE</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10" COLOR="#475569"><I>particulates</I></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">pm2_5_mean / pm2_5_max</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">pm10_mean / pm10_max</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">dust_mean</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">aod_mean</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(6,3)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10" COLOR="#475569"><I>gases</I></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">no2_mean</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">so2_mean</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">o3_8h_max</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(8,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">co_8h_max</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(10,2)</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10" COLOR="#475569"><I>indices (CPCB / US)</I></FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">india_aqi / india_aqi_category</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC / VARCHAR</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">dominant_pollutant</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">india_aqi_pm / india_aqi_pm_category</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC / VARCHAR</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">us_aqi_max</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">NUMERIC(6,2)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="38"><FONT COLOR="#94a3b8" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">hours_available</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">SMALLINT</FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#f1f5f9"><FONT POINT-SIZE="10" COLOR="#475569">77,400 rows  |  Fact  |  2022-08-05 to 2026-10-30  |  idx: date, category, dominant_pollutant</FONT></TD></TR></TABLE>>];
  master [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#334155" STYLE="rounded"><TR><TD BGCOLOR="#7c3aed"><FONT COLOR="white" POINT-SIZE="14"><B>vw_vayu_master</B></FONT> <FONT COLOR="white" POINT-SIZE="10">(VIEW)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>aq</B> INNER JOIN <B>weather</B> ON (city, date)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">INNER JOIN <B>cities</B> ON city</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">+ derived: year, month, month_name, <B>season</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">   Winter(Dec-Feb) | Summer(Mar-May)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">   Monsoon(Jun-Sep) | Post-Monsoon(Oct-Nov)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">77,400 rows (1 per city-day)</FONT></TD></TR></TABLE>>];
  summary [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#334155" STYLE="rounded"><TR><TD BGCOLOR="#9333ea"><FONT COLOR="white" POINT-SIZE="14"><B>vw_city_summary</B></FONT> <FONT COLOR="white" POINT-SIZE="10">(VIEW)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">GROUP BY city from vw_vayu_master</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">total_days, avg_india_aqi, avg_pm2_5</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">pct_clean_days, pct_unhealthy_days</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">50 rows (1 per city)</FONT></TD></TR></TABLE>>];
  consumers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fef9c3" COLOR="#a16207" STYLE="rounded"><TR><TD><B>Consumers</B></TD></TR><TR><TD ALIGN="LEFT">04_analysis_queries.sql (29 questions)</TD></TR><TR><TD ALIGN="LEFT">Power BI / Streamlit dashboards</TD></TR><TR><TD ALIGN="LEFT">FastAPI backend (backend/app.py)</TD></TR></TABLE>>];

  cities -> weather [dir=both, arrowtail=teeodot, arrowhead=crowodot, label="  1 : N   (FK city, ON DELETE CASCADE)  ", headlabel="", taillabel=""];
  cities -> aq      [dir=both, arrowtail=teeodot, arrowhead=crowodot, label="  1 : N   (FK city, ON DELETE CASCADE)  "];
  weather -> aq [dir=none, style=dashed, color="#7c3aed", constraint=false, label=<<FONT COLOR="#7c3aed">logical 1 : 1<BR/>on (city, date)<BR/>(weather starts 2020, AQ 2022)</FONT>>];
  weather -> master [style=dashed, color="#7c3aed"];
  aq -> master [style=dashed, color="#7c3aed"];
  cities -> master [style=dashed, color="#7c3aed", constraint=false];
  master -> summary [style=dashed, color="#9333ea"];
  master -> consumers [style=dotted, color="#a16207"];
  summary -> consumers [style=dotted, color="#a16207"];

  { rank=same; weather; aq; }
  { rank=same; master; summary; }
}